# Normalise to LF in the repo and in the working tree on every platform.
#
# Without this, a Windows checkout gets CRLF, and tooling that splits on '\n' is left with
# a trailing \r on every line. That is not hypothetical: it broke tools/lint-purity.mjs on
# the Windows CI runner while passing on a Windows laptop whose checkout happened to be LF.
* text=auto eol=lf

# Keep the service worker and manifest byte-identical everywhere; the SW caches by URL and
# a stray \r changes nothing functionally, but a diff that is purely line endings is noise.
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf
*.webmanifest text eol=lf

# The native Android project in android/. Kotlin, Gradle and resource files follow the
# repo-wide LF rule, but the Windows wrapper script must stay CRLF: cmd.exe misparses an
# LF-only .bat, and `gradlew.bat` is how the build runs on a Windows checkout.
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.toml  text eol=lf
*.pro   text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.bat   text eol=crlf

# Never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
*.jar   binary
*.webp  binary
*.jks   binary
*.keystore binary
