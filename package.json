{
  "name": "ideaforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interviewer that forges a half-formed idea into a usable LLM prompt.",
  "license": "MIT",
  "scripts": {
    "test": "npm run lint:purity && node --test \"test/**/*.test.mjs\"",
    "test:browser": "node tools/browser-check.mjs",
    "test:all": "npm test && npm run test:browser",
    "lint:purity": "node tools/lint-purity.mjs",
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "screenshots": "node tools/screenshots.mjs"
  }
}
