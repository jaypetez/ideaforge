{
  "name": "ideaforge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "An interviewer that forges a half-formed idea into a usable LLM prompt.",
  "license": "MIT",
  "scripts": {
    "test": "npm run lint:purity && node --test \"test/**/*.test.mjs\"",
    "test:docs": "node --test test/docs.test.mjs test/agent-support.test.mjs",
    "test:graph": "node tools/check-module-graph.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:browser:required": "node tools/browser-check.mjs --required",
    "test:all": "npm test && npm run test:graph && npm run test:browser:required",
    "lint:purity": "node tools/lint-purity.mjs",
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "screenshots": "node tools/screenshots.mjs",
    "validate:local": "node tools/validate-local.mjs"
  }
}
