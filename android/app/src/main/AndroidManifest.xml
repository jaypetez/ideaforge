<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Model and speech providers (:providers) are reached over HTTP; see network_security_config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation (voice/Recognizer.kt). SpeechRecognizer requires the caller to hold it even
         though the recognition service, not this app, opens the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Hands-free driving (voice/DriveService.kt): a microphone foreground service, because
         with the screen off and no such service the system silences recognition with no error
         (#89). Started only from a tap on the visible app; never restarts itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The drive's ongoing notification, with Pause and Exit (asked for on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+): without this, isRecognitionAvailable is false and
         SpeechRecognizer cannot bind the recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup is off: the only backups are the user's own session exports. Android
         cloud backup would carry the encrypted keyring to a device whose Keystore cannot
         decrypt it, and would copy transcripts somewhere the user never chose. -->
    <application
        android:name=".IdeaForgeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IdeaForge"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".voice.DriveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Share .md on the result screen: hands the chooser a content URI for the one
             export file it wrote under cache/exports (res/xml/export_paths.xml), with a
             read grant on the intent. Not exported; nothing else is reachable through it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>
</manifest>
